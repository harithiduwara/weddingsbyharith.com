{
  "name": "weddingsbyharith.com",
  "version": "1.10.0",
  "private": true,
  "description": "Marketing and portfolio website for Harith Iduwara Weddings \u2014 documentary wedding photography in Sri Lanka.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:clean": "rm -rf dist .cache && node tools/build.mjs",
    "build:staging": "node tools/build.mjs --preview-url=https://harithiduwara.github.io/weddingsbyharith.com",
    "images": "node tools/optimize-images.mjs",
    "instagram:import": "node tools/import-instagram.mjs",
    "predev": "node tools/build.mjs",
    "dev": "node tools/dev-server.mjs",
    "pretest": "node tools/build.mjs",
    "test": "npm run test:unit && npm run test:html && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test",
    "test:links": "linkinator http://localhost:4321 --recurse --silent --skip \"^https?://(?!localhost)\"",
    "format": "prettier --write \"**/*.{mjs,js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{mjs,js,css,json,md}\"",
    "deploy": "node tools/deploy.mjs",
    "deploy:staging": "npm run build:staging && node tools/deploy.mjs --force"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "html-validate": "^8.27.0",
    "linkinator": "^6.1.2",
    "prettier": "^3.4.2"
  }
}
